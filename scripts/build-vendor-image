#!/usr/bin/env bash
# Print only an immutable local image ID; build progress goes to stderr.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
case "${1:-}" in
  postgres|openbao|keycloak) component=$1 ;;
  *) echo 'Usage: scripts/build-vendor-image postgres|openbao|keycloak' >&2; exit 2 ;;
esac
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
# Preserve the failing RUN output (including HTTP status) in CI logs.
docker build --progress=plain --iidfile "$scratch/image-id" "$root/deploy/$component" >&2
image=$(cat "$scratch/image-id")
docker image inspect --format '{{.Id}}' "$image"
