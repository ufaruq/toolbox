# Private shell configuration: copy to work/keycloak/private.env (ignored).
# Keep the existing .env / direct-Okta settings for rollback.
TOOLBOX_ORIGIN=http://127.0.0.1:8080
TOOLBOX_KEYCLOAK_REALM=toolbox
TOOLBOX_KEYCLOAK_ISSUER=https://localhost:8443/realms/toolbox
TOOLBOX_KEYCLOAK_OWNER_CLIENT_ID=toolbox-owner
TOOLBOX_KEYCLOAK_OWNER_CLIENT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET

# New Okta Web Application for Keycloak, separate from the existing Toolbox app.
TOOLBOX_KEYCLOAK_OKTA_ISSUER=https://REPLACE.okta.com
TOOLBOX_KEYCLOAK_OKTA_CLIENT_ID=REPLACE_WITH_BROKER_CLIENT_ID
TOOLBOX_KEYCLOAK_OKTA_CLIENT_SECRET=REPLACE_WITH_BROKER_CLIENT_SECRET

# Optional Google login: client ID and secret are required if enabled.
# Leave hosted domain empty for personal Gmail and Workspace accounts; set an
# exact Workspace domain to restrict login to that organization.
TOOLBOX_KEYCLOAK_GOOGLE_CLIENT_ID=
TOOLBOX_KEYCLOAK_GOOGLE_CLIENT_SECRET=
TOOLBOX_KEYCLOAK_GOOGLE_HOSTED_DOMAIN=

# Public agent client: exact callback, S256 PKCE, no password/service-account flow.
TOOLBOX_KEYCLOAK_MCP_CLIENTS='{"toolbox-agent":"Local MCP agent"}'
TOOLBOX_KEYCLOAK_MCP_REDIRECT_URIS='{"toolbox-agent":["http://127.0.0.1:8765/callback"]}'

# Temporary read-only realm service client for verified migration, not runtime.
TOOLBOX_KEYCLOAK_ADMIN_CLIENT_ID=toolbox-migration
TOOLBOX_KEYCLOAK_ADMIN_CLIENT_SECRET=REPLACE_WITH_MIGRATION_CLIENT_SECRET
