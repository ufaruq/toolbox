# Copy to .env; never commit usable credentials. Run from a trusted local shell.
TOOLBOX_MODE=workspace-local
TOOLBOX_ADDR=127.0.0.1:8080
TOOLBOX_ORIGIN=http://127.0.0.1:8080
TOOLBOX_OIDC_ISSUER='https://<your-okta-org>.okta.com'
TOOLBOX_OIDC_CLIENT_ID='<okta-web-client-id>'
TOOLBOX_OIDC_CLIENT_SECRET='<okta-web-client-secret>'

# Generate each independently with openssl rand -base64 32. Preserve on restart.
TOOLBOX_SESSION_PEPPER='<base64-32-random-bytes>'
TOOLBOX_CREDENTIAL_PEPPER='<different-base64-32-random-bytes>'
TOOLBOX_SIGNING_SEED='<another-base64-32-random-bytes>'
TOOLBOX_SIGNING_KEY_ID='workspace-local-1'

DATABASE_URL='postgres://<user>:<password>@127.0.0.1:5432/<database>?sslmode=disable'
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN='<local-openbao-token>'

TOOLBOX_GOOGLE_CLIENT_ID='<google-web-client-id>'
TOOLBOX_GOOGLE_CLIENT_SECRET='<google-web-client-secret>'
TOOLBOX_GOOGLE_PICKER_API_KEY='<restricted-browser-api-key>'
TOOLBOX_GOOGLE_PROJECT_NUMBER='<numeric-project-number>'
# Keep false until make google-pkce-check passes for this exact configuration.
TOOLBOX_GOOGLE_PKCE_VALIDATED=false
