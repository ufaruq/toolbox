# Local owner sign-in only. Copy to .env, replace every <...> placeholder,
# then explicitly load it in your shell; the Go executable does not load dotenv.
# .env is ignored by Git. No credentials in this example are usable.
TOOLBOX_MODE=oidc-local
TOOLBOX_ADDR=127.0.0.1:8080
TOOLBOX_ORIGIN=http://127.0.0.1:8080

# Exact HTTPS issuer from your Okta application's organization or deliberately
# configured authorization server. The organization issuer needs no /oauth2/default.
TOOLBOX_OIDC_ISSUER='https://<your-okta-org>.okta.com'
TOOLBOX_OIDC_CLIENT_ID='<your-web-application-client-id>'
TOOLBOX_OIDC_CLIENT_SECRET='<your-web-application-client-secret>'

# Generate once with: openssl rand -base64 32
# Keep the same generated value across restarts of this local environment.
TOOLBOX_SESSION_PEPPER='<base64-encoding-of-exactly-32-random-bytes>'

# Both stores are required in oidc-local. See docs/okta-setup.md for the
# disposable Compose configuration; its dev credentials are not for production.
DATABASE_URL='postgres://<database-user>:<database-password>@127.0.0.1:5432/<database-name>?sslmode=disable'
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN='<local-openbao-token>'
